# Celcom Africa SMS (server-side only; configure these in Vercel)
CELCOM_SMS_API_KEY=
CELCOM_SMS_PARTNER_ID=36
CELCOM_SMS_SHORTCODE=TEXTME
# Optional override:
# CELCOM_SMS_ENDPOINT=https://isms.celcomafrica.com/api/services/sendsms

# Daraja M-Pesa (server-only; never use NEXT_PUBLIC_ for these)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://www.thesnohomish.com/api/mpesa/callback
# Use CustomerBuyGoodsOnline for a Till; CustomerPayBillOnline for Paybill.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods, set the receiving Till supplied by Safaricom when different from the shortcode.
MPESA_PARTY_B=
SUPABASE_SERVICE_ROLE_KEY=
